# hlw environment variables
# Copy this file to .env and fill in the values, or export them in your shell.
# hlw reads these via {{env:NAME}} placeholders in config.json.

# ── Secret tokens ────────────────────────────────────────────────────────────
# These are the only values you need to provide. Everything else has defaults.

# Token for the oMLX inference server (127.0.0.1:4000)
# Used by: claude, codex, opencode, pi, qwen harnesses
OMLX_API_KEY=

# Token for OpenRouter (used by the claude-openrouter harness)
OPENROUTER_API_KEY=

# ── Anthropic ────────────────────────────────────────────────────────────────
# ANTHROPIC_BASE_URL       — set via {{endpoint}} in config, no env var needed
# ANTHROPIC_AUTH_TOKEN     — set via {{env:OMLX_API_KEY}} or {{env:OPENROUTER_API_KEY}}
# ANTHROPIC_API_KEY        — left empty in config; override here if needed
# ANTHROPIC_DEFAULT_OPUS_MODEL, _SONNET_MODEL, _HAIKU_MODEL — set by hlw automatically

# ── OpenAI ───────────────────────────────────────────────────────────────────
# OPENAI_BASE_URL          — set via {{endpoint}}/v1 in config, no env var needed
# OPENAI_API_KEY           — set via {{env:OMLX_API_KEY}} in config

# ── Claude Code ──────────────────────────────────────────────────────────────
# These are hardcoded in config and do not need env vars:
#   CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
#   CLAUDE_CODE_MAX_CONTEXT_TOKENS=200000
#   CLAUDE_CODE_AUTO_COMPACT_WINDOW=158000
#   CLAUDE_AUTOCOMPACT_PCT_OVERRIDE=80
#   CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1  (claude-openrouter only)

# ── Other ────────────────────────────────────────────────────────────────────
# API_TIMEOUT_MS=3000000  (hardcoded in config)

# ── Usage ────────────────────────────────────────────────────────────────────
#
# Option 1 — source the file in your shell:
#   source .env
#
# Option 2 — export directly:
#   export OMLX_API_KEY="sk-..."
#   export OPENROUTER_API_KEY="sk-or-..."
#
# Option 3 — add to your shell RC (bash/zsh):
#   echo 'export OMLX_API_KEY="sk-..."' >> ~/.zshrc
#   echo 'export OPENROUTER_API_KEY="sk-or-..."' >> ~/.zshrc
#   source ~/.zshrc
